{
  "case_id": "sample_project_security_review_001",
  "task": "Review the sample project and find possible security or maintainability issues.",
  "must_inspect_files": [
    "sample_project/config.py",
    "sample_project/auth.py",
    "sample_project/app.py"
  ],
  "must_use_tools": [
    "list_files",
    "read_file",
    "add_finding",
    "write_report"
  ],
  "expected_findings": [
    {
      "file": "sample_project/config.py",
      "match_any": [
        "SECRET_KEY",
        "super-secret-hardcoded-key"
      ],
      "severity": "HIGH",
      "category": "SECURITY"
    },    
    {
      "file": "sample_project/config.py",
      "match_any": [
        "DATABASE_URL",
        "super-secret-hardcoded-key"
      ],
      "severity": "HIGH",
      "category": "SECURITY"
    },
    {
      "file": "sample_project/auth.py",
      "match_any": [
        "admin credentials",
        "administrator credentials",
        "username == \"admin\"",
        "password == \"admin\""
      ],
      "severity": "HIGH",
      "category": "SECURITY"
    },
    {
      "file": "sample_project/auth.py",
      "issue_contains": "token validation",
      "severity": "HIGH",
      "category": "SECURITY"
    },
    {
      "file": "sample_project/config.py",
      "match_any": [
        "DEBUG = True",
        "debug mode",
        "debug state",
        "\"debug\": DEBUG",
        "includes this value in the user profile response"
      ],
      "severity": "MEDIUM",
      "category": "SECURITY"
    }
  ]
}